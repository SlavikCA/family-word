---
layout: layouts/base.njk
title: Videos
description: Watch sermons and conference sessions for Christian families
---

<section class="page-header">
  <h1>Videos</h1>
  <p>Watch sermons and conference sessions to strengthen your family's faith.</p>
</section>

<section class="container">
  <div class="video-grid">
    {% for video in collections.video | reverse %}
    <article class="video-card">
      <div class="video-thumbnail">
        {% if video.data.videoId %}
        <img src="https://img.youtube.com/vi/{{ video.data.videoId }}/hqdefault.jpg" alt="{{ video.data.title }}" loading="lazy" style="width:100%; height:100%; object-fit:cover;">
        {% else %}
        <img src="{{ video.data.image | default('/assets/images/video-placeholder.svg') }}" alt="{{ video.data.title }}" loading="lazy" style="width:100%; height:100%; object-fit:cover;">
        {% endif %}
      </div>
      <div class="video-card-content">
        <p class="video-card-category">{{ video.data.category }}</p>
        <h2 class="video-card-title"><a href="{{ video.url }}">{{ video.data.title }}</a></h2>
        <p class="video-card-duration">{{ video.data.duration }}</p>
      </div>
    </article>
    {% endfor %}
  </div>
</section>