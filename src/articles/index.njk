---
layout: layouts/base.njk
title: Статьи
description: Статьи для христианских семей
---

<section class="container">
  <div class="article-list">
    {% for article in collections.article | reverse %}
    <article class="article-list-item">
      <p class="article-list-meta">
        <time datetime="{{ article.date | date('YYYY-MM-DD') }}">{{ article.date | date('MMMM D, YYYY') }}</time>
        {% if article.data.category %} · {{ article.data.category }}{% endif %}
      </p>
      <h2 class="article-list-title"><a href="{{ article.url }}">{{ article.data.title }}</a></h2>
      <p class="article-list-excerpt">{{ article.data.excerpt }}</p>
      <a href="{{ article.url }}" class="read-more">Read More →</a>
    </article>
    {% endfor %}
  </div>
</section>